<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chickencenter.ui.controllers.ReportsController"
      style="-fx-background-color: #F1F5F9; -fx-padding: 15;">

    <VBox style="-fx-background-color: #ffffff; -fx-padding: 12 20; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, #00000008, 3, 0, 0, 1);">
        <Label text="Financial Reports" textFill="#0F172A">
            <font>
                <Font size="18" name="Segoe UI Bold"/>
            </font>
        </Label>
    </VBox>

    <VBox spacing="15" style="-fx-padding: 15 0 0 0;">
        <VBox style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-padding: 12; -fx-effect: dropshadow(gaussian, #0000000d, 5, 0, 0, 2);">
            <HBox spacing="20" style="-fx-padding: 0 0 10 0;">
                <VBox spacing="5">
                    <Label text="From Date" textFill="#64748b">
                        <font>
                            <Font size="12" name="Segoe UI"/>
                        </font>
                    </Label>
                    <DatePicker fx:id="dpStartDate" prefWidth="160" prefHeight="30" style="-fx-background-radius: 5;"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="To Date" textFill="#64748b">
                        <font>
                            <Font size="12" name="Segoe UI"/>
                        </font>
                    </Label>
                    <DatePicker fx:id="dpEndDate" prefWidth="160" prefHeight="30" style="-fx-background-radius: 5;"/>
                </VBox>
                <Region prefWidth="30"/>
                <Button fx:id="btnGenerateReport" text="Generate Report" onAction="#generateReport" prefWidth="160" prefHeight="38"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </HBox>
        </VBox>

        <HBox spacing="12">
            <VBox alignment="CENTER" prefHeight="100" HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, #0000000d, 5, 0, 0, 2);">
                <VBox style="-fx-background-color: #10b981; -fx-padding: 10 15; -fx-background-radius: 8 8 0 0;" HBox.hgrow="ALWAYS">
                    <Label text="Total Sales" textFill="white">
                        <font>
                            <Font size="12" name="Segoe UI"/>
                        </font>
                    </Label>
                </VBox>
                <VBox alignment="CENTER" style="-fx-padding: 10;">
                    <Label fx:id="lblTotalSales" text="Rs.0.00" textFill="#0F172A">
                        <font>
                            <Font size="18" name="Segoe UI Bold"/>
                        </font>
                    </Label>
                </VBox>
            </VBox>

            <VBox alignment="CENTER" prefHeight="100" HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, #0000000d, 5, 0, 0, 2);">
                <VBox style="-fx-background-color: #f59e0b; -fx-padding: 10 15; -fx-background-radius: 8 8 0 0;">
                    <Label text="Total Purchases" textFill="white">
                        <font>
                            <Font size="12" name="Segoe UI"/>
                        </font>
                    </Label>
                </VBox>
                <VBox alignment="CENTER" style="-fx-padding: 10;">
                    <Label fx:id="lblTotalPurchases" text="Rs.0.00" textFill="#0F172A">
                        <font>
                            <Font size="18" name="Segoe UI Bold"/>
                        </font>
                    </Label>
                </VBox>
            </VBox>

            <VBox alignment="CENTER" prefHeight="100" HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, #0000000d, 5, 0, 0, 2);">
                <VBox style="-fx-background-color: #ef4444; -fx-padding: 10 15; -fx-background-radius: 8 8 0 0;">
                    <Label text="Total Expenses" textFill="white">
                        <font>
                            <Font size="12" name="Segoe UI"/>
                        </font>
                    </Label>
                </VBox>
                <VBox alignment="CENTER" style="-fx-padding: 10;">
                    <Label fx:id="lblTotalExpenses" text="Rs.0.00" textFill="#0F172A">
                        <font>
                            <Font size="18" name="Segoe UI Bold"/>
                        </font>
                    </Label>
                </VBox>
            </VBox>

            <VBox alignment="CENTER" prefHeight="100" HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, #0000000d, 5, 0, 0, 2);">
                <VBox style="-fx-background-color: #6366f1; -fx-padding: 10 15; -fx-background-radius: 8 8 0 0;">
                    <Label text="Net Profit/Loss" textFill="white">
                        <font>
                            <Font size="12" name="Segoe UI"/>
                        </font>
                    </Label>
                </VBox>
                <VBox alignment="CENTER" style="-fx-padding: 10;">
                    <Label fx:id="lblNetProfit" text="Rs.0.00" textFill="#0F172A">
                        <font>
                            <Font size="18" name="Segoe UI Bold"/>
                        </font>
                    </Label>
                </VBox>
            </VBox>
        </HBox>

        <VBox style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-padding: 12; -fx-effect: dropshadow(gaussian, #0000000d, 5, 0, 0, 2);">
            <HBox style="-fx-padding: 0 0 10 0;">
                <Label text="Sales Details" textFill="#0F172A">
                    <font>
                        <Font size="14" name="Segoe UI Bold"/>
                    </font>
                </Label>
            </HBox>
            <Separator/>
            <TableView fx:id="tblSalesReport" prefHeight="280" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 4; -fx-table-cell-border-color: #e2e8f0;">
                <columns>
                    <TableColumn fx:id="colSaleId" text="Sale ID" prefWidth="120" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colSaleDate" text="Date" prefWidth="200" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colSaleAmount" text="Amount" prefWidth="180" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colSaleStatus" text="Status" prefWidth="120" style="-fx-alignment: CENTER;"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>

</VBox>