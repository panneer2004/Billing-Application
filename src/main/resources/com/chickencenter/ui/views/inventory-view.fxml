<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chickencenter.ui.controllers.InventoryController"
      style="-fx-background-color: #F1F5F9; -fx-padding: 15;" spacing="15">

    <!-- Header -->
    <VBox style="-fx-background-color: #ffffff; -fx-padding: 12 20; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, #00000008, 3, 0, 0, 1);">
        <Label text="Inventory Management" textFill="#0F172A">
            <font>
                <Font size="18" name="Segoe UI Bold"/>
            </font>
        </Label>
    </VBox>

    <!-- Form Section -->
    <VBox style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, #0000000d, 5, 0, 0, 2);">
        <HBox style="-fx-padding: 0 0 15 0;">
            <Label text="Product Details" textFill="#0F172A">
                <font>
                    <Font size="14" name="Segoe UI Bold"/>
                </font>
            </Label>
        </HBox>

        <HBox spacing="20">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Product Name" textFill="#64748b">
                    <font>
                        <Font size="12" name="Segoe UI"/>
                    </font>
                </Label>
                <TextField fx:id="txtName" style="-fx-background-radius: 5; -fx-padding: 8 10;"/>
            </VBox>

            <VBox spacing="5" prefWidth="120">
                <Label text="Unit" textFill="#64748b">
                    <font>
                        <Font size="12" name="Segoe UI"/>
                    </font>
                </Label>
                <TextField fx:id="txtUnit" style="-fx-background-radius: 5; -fx-padding: 8 10;"/>
            </VBox>

            <VBox spacing="5" prefWidth="200">
                <Label text="Vendor" textFill="#64748b">
                    <font>
                        <Font size="12" name="Segoe UI"/>
                    </font>
                </Label>
                <ComboBox fx:id="cmbVendor" promptText="Select Vendor" prefWidth="190"
                          style="-fx-background-radius: 5; -fx-padding: 8 10;"/>
            </VBox>

            <VBox spacing="5" alignment="BOTTOM_LEFT">
                <Button fx:id="btnAdd" text="Add" onAction="#addItem" prefWidth="90" prefHeight="38"
                        style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </VBox>

            <VBox spacing="5" alignment="BOTTOM_LEFT">
                <Button fx:id="btnUpdate" text="Update" onAction="#updateItem" prefWidth="90" prefHeight="38"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;"/>
            </VBox>

            <VBox spacing="5" alignment="BOTTOM_LEFT">
                <Button fx:id="btnDelete" text="Delete" onAction="#deleteItem" prefWidth="90" prefHeight="38"
                        style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- Table Section -->
    <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-padding: 12; -fx-effect: dropshadow(gaussian, #0000000d, 5, 0, 0, 2);">
        <HBox style="-fx-padding: 0 0 10 0;">
            <Label text="Product List" textFill="#0F172A">
                <font>
                    <Font size="14" name="Segoe UI Bold"/>
                </font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField promptText="Search products..." prefWidth="200"
                       style="-fx-background-radius: 5; -fx-padding: 6 10;"/>
        </HBox>

        <TableView fx:id="tblInventory" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 4; -fx-table-cell-border-color: #e2e8f0;">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colName" text="Product Name" prefWidth="200" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colUnit" text="Unit" prefWidth="80" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colVendor" text="Vendor" prefWidth="120" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colStock" text="Stock" prefWidth="90" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colPrice" text="Price" prefWidth="90" style="-fx-alignment: CENTER;"/>
            </columns>
        </TableView>
    </VBox>

    <!-- Update Stock Button -->
    <Button text="Update Stock" onAction="#updateStock" prefWidth="200" prefHeight="38"
            style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold; -fx-cursor: hand;" alignment="CENTER_LEFT"/>

</VBox>
