<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chickencenter.ui.controllers.PurchaseController"
            style="-fx-background-color: #eef2f7;">

    <top>
        <VBox style="-fx-background-color: #ffffff; -fx-effect: dropshadow(gaussian, #00000008, 4, 0, 0, 2);">
            <HBox>
                <VBox>
                    <Label text="Purchase Stock" textFill="#1e3a5f">
                        <font>
                            <Font size="24" name="Segoe UI Bold"/>
                        </font>
                    </Label>
                    <Label text="Add new stock from vendors" textFill="#64748b" style="-fx-padding: 3 0 0 0;">
                        <font>
                            <Font size="13" name="Segoe UI"/>
                        </font>
                    </Label>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox alignment="CENTER" style="-fx-padding: 50;">
            <VBox spacing="20" prefWidth="480" style="-fx-background-color: #ffffff; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, #00000006, 10, 0, 0, 4);">
                <VBox style="-fx-padding: 25 25 0 25;">
                    <Label text="Purchase Details" textFill="#1e3a5f">
                        <font>
                            <Font size="18" name="Segoe UI Bold"/>
                        </font>
                    </Label>
                </VBox>
                
                <VBox spacing="15" style="-fx-padding: 25;">
                    <VBox spacing="5">
                        <HBox>
                            <Label text="Select Vendor" textFill="#64748b">
                                <font>
                                    <Font size="12" name="Segoe UI"/>
                                </font>
                            </Label>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="+ Add New Vendor" onAction="#openAddVendor" prefHeight="28"
                                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-size: 11; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        </HBox>
                        <ComboBox fx:id="cmbVendor" promptText="Choose Vendor" prefWidth="430" style="-fx-background-radius: 8; -fx-padding: 8;"/>
                    </VBox>
                    
                    <VBox spacing="5">
                        <Label text="Select Product" textFill="#64748b">
                            <font>
                                <Font size="12" name="Segoe UI"/>
                            </font>
                        </Label>
                        <ComboBox fx:id="cmbItem" promptText="Choose Product" prefWidth="430" style="-fx-background-radius: 8; -fx-padding: 8;"/>
                    </VBox>
                    
                    <HBox spacing="15">
                        <VBox spacing="5" prefWidth="200">
                            <Label text="Quantity" textFill="#64748b">
                                <font>
                                    <Font size="12" name="Segoe UI"/>
                                </font>
                            </Label>
                            <TextField fx:id="txtQuantity" style="-fx-background-radius: 8; -fx-padding: 10;"/>
                        </VBox>
                        <VBox spacing="5" prefWidth="215">
                            <Label text="Price Per Unit (Rs.)" textFill="#64748b">
                                <font>
                                    <Font size="12" name="Segoe UI"/>
                                </font>
                            </Label>
                            <TextField fx:id="txtPricePerUnit" style="-fx-background-radius: 8; -fx-padding: 10;"/>
                        </VBox>
                    </HBox>
                    
                    <VBox spacing="5">
                        <Label text="Total Amount (Rs.)" textFill="#64748b">
                            <font>
                                <Font size="12" name="Segoe UI"/>
                            </font>
                        </Label>
                        <TextField fx:id="txtTotalAmount" editable="false" style="-fx-background-color: #f1f5f9; -fx-background-radius: 8;">
                            <font>
                                <Font size="18" name="Segoe UI Bold"/>
                            </font>
                        </TextField>
                    </VBox>
                </VBox>
                
                <Separator style="-fx-padding: 0 25;"/>
                
                <VBox style="-fx-padding: 20 25 25 25;">
                    <Button fx:id="btnPurchase" text="Make Purchase" onAction="#makePurchase" prefWidth="430" prefHeight="50"
                            style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-size: 16; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </VBox>
            </VBox>
        </HBox>
    </center>

</BorderPane>
