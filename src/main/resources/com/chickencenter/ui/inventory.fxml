<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chickencenter.ui.controllers.InventoryController"
            style="-fx-background-color: #eef2f7;">

    <top>
        <VBox style="-fx-background-color: #ffffff; -fx-padding: 18 30; -fx-effect: dropshadow(gaussian, #00000008, 4, 0, 0, 2);">
            <HBox>
                <VBox>
                    <Label text="Inventory Management" textFill="#1e3a5f">
                        <font>
                            <Font size="24" name="Segoe UI Bold"/>
                        </font>
                    </Label>
                    <Label text="Manage your stock and products" textFill="#64748b" style="-fx-padding: 3 0 0 0;">
                        <font>
                            <Font size="13" name="Segoe UI"/>
                        </font>
                    </Label>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="25" style="-fx-padding: 25;">
            <VBox spacing="15" prefWidth="600" style="-fx-background-color: #ffffff; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, #00000006, 10, 0, 0, 4);">
                <VBox style="-fx-padding: 18;">
                    <HBox>
                        <Label text="Product List" textFill="#1e3a5f">
                            <font>
                                <Font size="16" name="Segoe UI Bold"/>
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS"/>
                        <TextField promptText="Search products..." prefWidth="200" style="-fx-background-radius: 8; -fx-padding: 8;"/>
                    </HBox>
                </VBox>
                <TableView fx:id="tblInventory" prefHeight="400" style="-fx-background-color: white;">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="colName" text="Product Name" prefWidth="200"/>
                        <TableColumn fx:id="colUnit" text="Unit" prefWidth="80"/>
                        <TableColumn fx:id="colVendor" text="Vendor" prefWidth="80"/>
                        <TableColumn fx:id="colStock" text="Stock" prefWidth="90"/>
                        <TableColumn fx:id="colPrice" text="Price" prefWidth="90"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox spacing="15" prefWidth="320" style="-fx-background-color: #ffffff; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, #00000006, 10, 0, 0, 4);">
                <VBox style="-fx-padding: 18;">
                    <Label text="Product Details" textFill="#1e3a5f">
                        <font>
                            <Font size="16" name="Segoe UI Bold"/>
                        </font>
                    </Label>
                </VBox>
                <Separator/>
                <VBox spacing="12" style="-fx-padding: 18;">
                    <VBox spacing="5">
                        <Label text="Product Name" textFill="#64748b">
                            <font>
                                <Font size="12" name="Segoe UI"/>
                            </font>
                        </Label>
                        <TextField fx:id="txtName" style="-fx-background-radius: 8; -fx-padding: 10;"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Unit" textFill="#64748b">
                            <font>
                                <Font size="12" name="Segoe UI"/>
                            </font>
                        </Label>
                        <TextField fx:id="txtUnit" style="-fx-background-radius: 8; -fx-padding: 10;"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Vendor" textFill="#64748b">
                            <font>
                                <Font size="12" name="Segoe UI"/>
                            </font>
                        </Label>
                        <ComboBox fx:id="cmbVendor" promptText="Select Vendor" prefWidth="280" style="-fx-background-radius: 8;"/>
                    </VBox>
                </VBox>
                <Separator/>
                <HBox spacing="10" style="-fx-padding: 15 18;">
                    <Button fx:id="btnAdd" text="Add" onAction="#addItem" prefWidth="85" prefHeight="36"
                            style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    <Button fx:id="btnUpdate" text="Update" onAction="#updateItem" prefWidth="85" prefHeight="36"
                            style="-fx-background-color: #0ea5e9; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"/>
                    <Button fx:id="btnDelete" text="Delete" onAction="#deleteItem" prefWidth="85" prefHeight="36"
                            style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"/>
                </HBox>
                <Separator/>
                <VBox style="-fx-padding: 15 18;">
                    <Button text="Update Stock" onAction="#updateStock" prefWidth="280" prefHeight="42"
                            style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </VBox>
            </VBox>
        </HBox>
    </center>

</BorderPane>
