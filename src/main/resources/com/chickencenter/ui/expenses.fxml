<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chickencenter.ui.controllers.ExpensesController"
            style="-fx-background-color: #eef2f7;">

    <top>
        <VBox style="-fx-background-color: #ffffff; -fx-padding: 18 30; -fx-effect: dropshadow(gaussian, #00000008, 4, 0, 0, 2);">
            <HBox>
                <VBox>
                    <Label text="Expenses Management" textFill="#1e3a5f">
                        <font>
                            <Font size="24" name="Segoe UI Bold"/>
                        </font>
                    </Label>
                    <Label text="Track vendor and employee expenses" textFill="#64748b" style="-fx-padding: 3 0 0 0;">
                        <font>
                            <Font size="13" name="Segoe UI"/>
                        </font>
                    </Label>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <TabPane style="-fx-background-color: #eef2f7; -fx-padding: 25;">
            <Tab text="Vendor Expenses">
                <HBox spacing="25" style="-fx-padding: 20;">
                    <VBox spacing="15" prefWidth="560" style="-fx-background-color: #ffffff; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, #00000006, 10, 0, 0, 4);">
                        <VBox style="-fx-padding: 18;">
                            <Label text="Vendor Expenses List" textFill="#1e3a5f">
                                <font>
                                    <Font size="16" name="Segoe UI Bold"/>
                                </font>
                            </Label>
                        </VBox>
                        <TableView fx:id="tblVendorExpenses" prefHeight="380" style="-fx-background-color: white;">
                            <columns>
                                <TableColumn fx:id="colVEId" text="ID" prefWidth="50"/>
                                <TableColumn fx:id="colVEVendor" text="Vendor" prefWidth="180"/>
                                <TableColumn fx:id="colVENote" text="Note" prefWidth="180"/>
                                <TableColumn fx:id="colVEAmount" text="Amount" prefWidth="100"/>
                                <TableColumn fx:id="colVEDate" text="Date" prefWidth="90"/>
                            </columns>
                        </TableView>
                        <HBox style="-fx-padding: 15 18;">
                            <Button text="Delete Selected" onAction="#deleteVendorExpense" prefWidth="140" prefHeight="36"
                                    style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="15" prefWidth="340" style="-fx-background-color: #ffffff; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, #00000006, 10, 0, 0, 4);">
                        <VBox style="-fx-padding: 18;">
                            <Label text="Add Vendor Expense" textFill="#1e3a5f">
                                <font>
                                    <Font size="16" name="Segoe UI Bold"/>
                                </font>
                            </Label>
                        </VBox>
                        <Separator/>
                        <VBox spacing="12" style="-fx-padding: 18;">
                            <VBox spacing="5">
                                <Label text="Select Vendor" textFill="#64748b">
                                    <font>
                                        <Font size="12" name="Segoe UI"/>
                                    </font>
                                </Label>
                                <ComboBox fx:id="cmbExpenseVendor" promptText="Choose Vendor" prefWidth="300" style="-fx-background-radius: 8;"/>
                            </VBox>
                            <VBox spacing="5">
                                <Label text="Note" textFill="#64748b">
                                    <font>
                                        <Font size="12" name="Segoe UI"/>
                                    </font>
                                </Label>
                                <TextField fx:id="txtNote" style="-fx-background-radius: 8; -fx-padding: 10;"/>
                            </VBox>
                            <VBox spacing="5">
                                <Label text="Amount (Rs.)" textFill="#64748b">
                                    <font>
                                        <Font size="12" name="Segoe UI"/>
                                    </font>
                                </Label>
                                <TextField fx:id="txtAmount" style="-fx-background-radius: 8; -fx-padding: 10;"/>
                            </VBox>
                            <VBox spacing="5">
                                <Label text="Date" textFill="#64748b">
                                    <font>
                                        <Font size="12" name="Segoe UI"/>
                                    </font>
                                </Label>
                                <DatePicker fx:id="dpExpenseDate" prefWidth="300" style="-fx-background-radius: 8;"/>
                            </VBox>
                        </VBox>
                        <Separator/>
                        <VBox style="-fx-padding: 15 18;">
                            <Button fx:id="btnAddVendorExpense" text="Add Expense" onAction="#addVendorExpense" prefWidth="300" prefHeight="42"
                                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        </VBox>
                    </VBox>
                </HBox>
            </Tab>

            <Tab text="Employee Expenses">
                <HBox spacing="25" style="-fx-padding: 20;">
                    <VBox spacing="15" prefWidth="560" style="-fx-background-color: #ffffff; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, #00000006, 10, 0, 0, 4);">
                        <VBox style="-fx-padding: 18;">
                            <Label text="Employee Expenses List" textFill="#1e3a5f">
                                <font>
                                    <Font size="16" name="Segoe UI Bold"/>
                                </font>
                            </Label>
                        </VBox>
                        <TableView fx:id="tblEmployeeExpenses" prefHeight="380" style="-fx-background-color: white;">
                            <columns>
                                <TableColumn fx:id="colEEId" text="ID" prefWidth="50"/>
                                <TableColumn fx:id="colEEEmployee" text="Employee" prefWidth="180"/>
                                <TableColumn fx:id="colEENote" text="Note" prefWidth="180"/>
                                <TableColumn fx:id="colEEAmount" text="Amount" prefWidth="100"/>
                                <TableColumn fx:id="colEEDate" text="Date" prefWidth="90"/>
                            </columns>
                        </TableView>
                        <HBox style="-fx-padding: 15 18;">
                            <Button text="Delete Selected" onAction="#deleteEmployeeExpense" prefWidth="140" prefHeight="36"
                                    style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="15" prefWidth="340" style="-fx-background-color: #ffffff; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, #00000006, 10, 0, 0, 4);">
                        <VBox style="-fx-padding: 18;">
                            <Label text="Add Employee Expense" textFill="#1e3a5f">
                                <font>
                                    <Font size="16" name="Segoe UI Bold"/>
                                </font>
                            </Label>
                        </VBox>
                        <Separator/>
                        <VBox spacing="12" style="-fx-padding: 18;">
                            <VBox spacing="5">
                                <Label text="Select Employee" textFill="#64748b">
                                    <font>
                                        <Font size="12" name="Segoe UI"/>
                                    </font>
                                </Label>
                                <ComboBox fx:id="cmbExpenseEmployee" promptText="Choose Employee" prefWidth="300" style="-fx-background-radius: 8;"/>
                            </VBox>
                            <VBox spacing="5">
                                <Label text="Note" textFill="#64748b">
                                    <font>
                                        <Font size="12" name="Segoe UI"/>
                                    </font>
                                </Label>
                                <TextField fx:id="txtNote" style="-fx-background-radius: 8; -fx-padding: 10;"/>
                            </VBox>
                            <VBox spacing="5">
                                <Label text="Amount (Rs.)" textFill="#64748b">
                                    <font>
                                        <Font size="12" name="Segoe UI"/>
                                    </font>
                                </Label>
                                <TextField fx:id="txtAmount" style="-fx-background-radius: 8; -fx-padding: 10;"/>
                            </VBox>
                            <VBox spacing="5">
                                <Label text="Date" textFill="#64748b">
                                    <font>
                                        <Font size="12" name="Segoe UI"/>
                                    </font>
                                </Label>
                                <DatePicker fx:id="dpExpenseDate" prefWidth="300" style="-fx-background-radius: 8;"/>
                            </VBox>
                        </VBox>
                        <Separator/>
                        <VBox style="-fx-padding: 15 18;">
                            <Button fx:id="btnAddEmployeeExpense" text="Add Expense" onAction="#addEmployeeExpense" prefWidth="300" prefHeight="42"
                                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        </VBox>
                    </VBox>
                </HBox>
            </Tab>
        </TabPane>
    </center>

</BorderPane>
