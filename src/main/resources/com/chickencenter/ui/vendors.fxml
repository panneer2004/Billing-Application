<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chickencenter.ui.controllers.VendorsController"
            style="-fx-background-color: #eef2f7;">

    <top>
        <VBox style="-fx-background-color: #ffffff; -fx-padding: 18 30; -fx-effect: dropshadow(gaussian, #00000008, 4, 0, 0, 2);">
            <HBox>
                <VBox>
                    <Label text="Vendor Management" textFill="#1e3a5f">
                        <font>
                            <Font size="24" name="Segoe UI Bold"/>
                        </font>
                    </Label>
                    <Label text="Manage your suppliers and vendors" textFill="#64748b" style="-fx-padding: 3 0 0 0;">
                        <font>
                            <Font size="13" name="Segoe UI"/>
                        </font>
                    </Label>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="25" style="-fx-padding: 25;">
            <VBox spacing="15" prefWidth="540" style="-fx-background-color: #ffffff; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, #00000006, 10, 0, 0, 4);">
                <VBox style="-fx-padding: 18;">
                    <HBox>
                        <Label text="Vendor List" textFill="#1e3a5f">
                            <font>
                                <Font size="16" name="Segoe UI Bold"/>
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS"/>
                        <TextField promptText="Search vendors..." prefWidth="150" style="-fx-background-radius: 8; -fx-padding: 8;"/>
                        <Region prefWidth="10"/>
                        <Button text="+ Add Product" onAction="#openAddProduct" prefHeight="34"
                                style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 12; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>
                <TableView fx:id="tblVendors" prefHeight="400" style="-fx-background-color: white;">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="colName" text="Vendor Name" prefWidth="280"/>
                        <TableColumn fx:id="colContact" text="Contact" prefWidth="170"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox spacing="15" prefWidth="340" style="-fx-background-color: #ffffff; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, #00000006, 10, 0, 0, 4);">
                <VBox style="-fx-padding: 18;">
                    <Label text="Vendor Details" textFill="#1e3a5f">
                        <font>
                            <Font size="16" name="Segoe UI Bold"/>
                        </font>
                    </Label>
                </VBox>
                <Separator/>
                <VBox spacing="15" style="-fx-padding: 20;">
                    <VBox spacing="5">
                        <Label text="Vendor Name" textFill="#64748b">
                            <font>
                                <Font size="12" name="Segoe UI"/>
                            </font>
                        </Label>
                        <TextField fx:id="txtName" style="-fx-background-radius: 8; -fx-padding: 10;"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Contact Number" textFill="#64748b">
                            <font>
                                <Font size="12" name="Segoe UI"/>
                            </font>
                        </Label>
                        <TextField fx:id="txtContact" style="-fx-background-radius: 8; -fx-padding: 10;"/>
                    </VBox>
                </VBox>
                <Separator/>
                <HBox spacing="10" style="-fx-padding: 18;">
                    <Button fx:id="btnAdd" text="Add Vendor" onAction="#addVendor" prefWidth="100" prefHeight="38"
                            style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    <Button fx:id="btnUpdate" text="Update" onAction="#updateVendor" prefWidth="100" prefHeight="38"
                            style="-fx-background-color: #0ea5e9; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"/>
                    <Button fx:id="btnDelete" text="Delete" onAction="#deleteVendor" prefWidth="100" prefHeight="38"
                            style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </HBox>
    </center>

</BorderPane>
