<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chickencenter.ui.controllers.VendorsController"
      style="-fx-background-color: #F1F5F9; -fx-padding: 15;" spacing="15">

    <!-- Header -->
    <VBox style="-fx-background-color: #ffffff; -fx-padding: 12 20; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, #00000008, 3, 0, 0, 1);">
        <Label text="Vendors" textFill="#0F172A">
            <font>
                <Font size="18" name="Segoe UI Bold"/>
            </font>
        </Label>
    </VBox>

    <!-- Form Section -->
    <VBox style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, #0000000d, 5, 0, 0, 2);">
        <HBox style="-fx-padding: 0 0 15 0;">
            <Label text="Add / Edit Vendor" textFill="#0F172A">
                <font>
                    <Font size="14" name="Segoe UI Bold"/>
                </font>
            </Label>
        </HBox>

        <HBox spacing="20">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Name" textFill="#64748b">
                    <font>
                        <Font size="12" name="Segoe UI"/>
                    </font>
                </Label>
                <TextField fx:id="txtName" promptText="Enter vendor name"
                           style="-fx-background-radius: 5; -fx-padding: 8 10;"/>
            </VBox>

            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Contact" textFill="#64748b">
                    <font>
                        <Font size="12" name="Segoe UI"/>
                    </font>
                </Label>
                <TextField fx:id="txtContact" promptText="Enter contact number"
                           style="-fx-background-radius: 5; -fx-padding: 8 10;"/>
            </VBox>

            <VBox spacing="5" alignment="BOTTOM_LEFT">
                <Button fx:id="btnSave" text="Save" onAction="#saveVendor" prefWidth="100" prefHeight="38"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-size: 13; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </VBox>

            <VBox spacing="5" alignment="BOTTOM_LEFT">
                <Button fx:id="btnClear" text="Clear" onAction="#clearFormClick" prefWidth="100" prefHeight="38"
                        style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-size: 13; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- Table Section -->
    <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-padding: 12; -fx-effect: dropshadow(gaussian, #0000000d, 5, 0, 0, 2);">
        <HBox style="-fx-padding: 0 0 10 0;">
            <Label text="Vendor List" textFill="#0F172A">
                <font>
                    <Font size="14" name="Segoe UI Bold"/>
                </font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="txtSearch" onKeyReleased="#searchVendors" promptText="Search..." prefWidth="180"
                       style="-fx-background-radius: 5; -fx-padding: 6 10;"/>
        </HBox>

        <TableView fx:id="tblVendors" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 4; -fx-table-cell-border-color: #e2e8f0;">
            <columns>
                <TableColumn fx:id="colName" text="Vendor Name" prefWidth="300" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colContact" text="Contact" prefWidth="200" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colAction" text="Action" prefWidth="120" minWidth="100" style="-fx-alignment: CENTER;"/>
            </columns>
        </TableView>
    </VBox>

</VBox>
