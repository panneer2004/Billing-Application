<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chickencenter.ui.controllers.PurchaseController"
      style="-fx-background-color: #F1F5F9; -fx-padding: 15;" spacing="15">

    <!-- Header -->
    <VBox style="-fx-background-color: #ffffff; -fx-padding: 12 20; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, #00000008, 3, 0, 0, 1);">
        <Label text="Purchase" textFill="#0F172A">
            <font>
                <Font size="18" name="Segoe UI Bold"/>
            </font>
        </Label>
    </VBox>

    <!-- Form Section -->
    <VBox style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, #0000000d, 5, 0, 0, 2);">
        <HBox style="-fx-padding: 0 0 15 0;">
            <Label text="Make Purchase" textFill="#0F172A">
                <font>
                    <Font size="14" name="Segoe UI Bold"/>
                </font>
            </Label>
        </HBox>

        <HBox spacing="20">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Select Product" textFill="#64748b">
                    <font>
                        <Font size="12" name="Segoe UI"/>
                    </font>
                </Label>
                <ComboBox fx:id="cmbProduct" promptText="Choose Product"
                          style="-fx-background-radius: 5; -fx-padding: 8 10;"/>
            </VBox>

            <VBox spacing="5" prefWidth="200">
                <Label text="Vendor Name" textFill="#64748b">
                    <font>
                        <Font size="12" name="Segoe UI"/>
                    </font>
                </Label>
                <TextField fx:id="txtVendorName" editable="false"
                           style="-fx-background-radius: 5; -fx-padding: 8 10; -fx-text-fill: #64748b;"/>
            </VBox>

            <VBox spacing="5" prefWidth="130">
                <Label text="Quantity" textFill="#64748b">
                    <font>
                        <Font size="12" name="Segoe UI"/>
                    </font>
                </Label>
                <TextField fx:id="txtQuantity" promptText="Enter quantity"
                           style="-fx-background-radius: 5; -fx-padding: 8 10;"/>
            </VBox>

            <VBox spacing="5" prefWidth="130">
                <Label text="Rate (Rs.)" textFill="#64748b">
                    <font>
                        <Font size="12" name="Segoe UI"/>
                    </font>
                </Label>
                <TextField fx:id="txtRate" promptText="Enter rate"
                           style="-fx-background-radius: 5; -fx-padding: 8 10;"/>
            </VBox>

            <VBox spacing="5" prefWidth="140">
                <Label text="Total Amount" textFill="#64748b">
                    <font>
                        <Font size="12" name="Segoe UI"/>
                    </font>
                </Label>
                <Label fx:id="lblTotalAmount" text="Rs. 0.00" textFill="#0F172A"
                       style="-fx-background-color: #f1f5f9; -fx-background-radius: 5; -fx-padding: 8 10; -fx-font-weight: bold; -fx-font-size: 13;"/>
            </VBox>

            <VBox spacing="5" alignment="BOTTOM_LEFT">
                <Button fx:id="btnPurchase" text="Purchase" onAction="#makePurchase" prefWidth="110" prefHeight="38"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-size: 13; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </VBox>

            <VBox spacing="5" alignment="BOTTOM_LEFT">
                <Button text="Clear" onAction="#clearFields" prefWidth="100" prefHeight="38"
                        style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-size: 13; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- Table Section -->
    <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-padding: 12; -fx-effect: dropshadow(gaussian, #0000000d, 5, 0, 0, 2);">
        <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 0 0 10 0;">
            <Label text="Purchase History" textFill="#0F172A">
                <font>
                    <Font size="14" name="Segoe UI Bold"/>
                </font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>

            <Label text="From:" textFill="#64748b" style="-fx-font-size: 12;"/>
            <DatePicker fx:id="dpFromDate" prefWidth="120" prefHeight="30" style="-fx-background-radius: 5;"/>

            <Label text="To:" textFill="#64748b" style="-fx-font-size: 12;"/>
            <DatePicker fx:id="dpToDate" prefWidth="120" prefHeight="30" style="-fx-background-radius: 5;"/>

            <Button fx:id="btnExport" text="Export Excel" onAction="#exportToExcel" prefWidth="110" prefHeight="32"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-size: 11; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </HBox>

        <TableView fx:id="tblPurchases" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 4; -fx-table-cell-border-color: #e2e8f0;">
            <columns>
                <TableColumn fx:id="colProductName" text="Product" prefWidth="140" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colVendorName" text="Vendor" prefWidth="110" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colBatchId" text="Batch" prefWidth="60" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colQuantity" text="Qty" prefWidth="70" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colBalanceQty" text="Balance Qty" prefWidth="100" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colRate" text="Rate" prefWidth="80" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colTotalAmount" text="Amount" prefWidth="100" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colAction" text="Action" prefWidth="110" minWidth="100" style="-fx-alignment: CENTER;"/>
            </columns>
        </TableView>
    </VBox>

</VBox>
