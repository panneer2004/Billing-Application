<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chickencenter.ui.controllers.SalesController"
      style="-fx-background-color: #F1F5F9; -fx-padding: 15;">

    <VBox style="-fx-background-color: #ffffff; -fx-padding: 12 20; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, #00000008, 3, 0, 0, 1);">
        <Label text="Sales History" textFill="#0F172A">
            <font>
                <Font size="18" name="Segoe UI Bold"/>
            </font>
        </Label>
    </VBox>

    <HBox spacing="12" style="-fx-padding: 12 0 0 0;">
        <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-padding: 16; -fx-effect: dropshadow(gaussian, #0000000d, 5, 0, 0, 2);">
            <Label text="Total Cash" textFill="#64748b" style="-fx-font-size: 13;">
                <font>
                    <Font name="Segoe UI"/>
                </font>
            </Label>
            <Label fx:id="lblTotalCash" text="Rs. 0.00" textFill="#10b981" style="-fx-font-size: 22; -fx-font-weight: bold;">
                <VBox.margin>
                    <Insets top="4"/>
                </VBox.margin>
            </Label>
        </VBox>

        <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-padding: 16; -fx-effect: dropshadow(gaussian, #0000000d, 5, 0, 0, 2);">
            <Label text="Total GPay" textFill="#64748b" style="-fx-font-size: 13;">
                <font>
                    <Font name="Segoe UI"/>
                </font>
            </Label>
            <Label fx:id="lblTotalGPay" text="Rs. 0.00" textFill="#2563eb" style="-fx-font-size: 22; -fx-font-weight: bold;">
                <VBox.margin>
                    <Insets top="4"/>
                </VBox.margin>
            </Label>
        </VBox>
    </HBox>

    <VBox style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-padding: 12 16; -fx-effect: dropshadow(gaussian, #0000000d, 5, 0, 0, 2); -fx-padding: 16;">
        <VBox.margin>
            <Insets top="12"/>
        </VBox.margin>
        <Label text="Product-wise Sales Summary" textFill="#0F172A" style="-fx-font-size: 14; -fx-font-weight: bold;">
            <VBox.margin>
                <Insets bottom="10"/>
            </VBox.margin>
        </Label>
        <FlowPane fx:id="productSummaryContainer" hgap="10" vgap="8" style="-fx-padding: 0 0 10 0;"/>
    </VBox>

    <VBox style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-padding: 12; -fx-effect: dropshadow(gaussian, #0000000d, 5, 0, 0, 2);">
        <VBox.margin>
            <Insets top="12"/>
        </VBox.margin>
        
        <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 0 0 10 0;">
            <Label text="From:" textFill="#64748b" style="-fx-font-size: 12;">
                <HBox.margin>
                    <Insets top="6" />
                </HBox.margin>
            </Label>
            <DatePicker fx:id="dpFromDate" prefWidth="130" prefHeight="30" style="-fx-background-radius: 5;"/>
            
            <Label text="To:" textFill="#64748b" style="-fx-font-size: 12;">
                <HBox.margin>
                    <Insets top="6" />
                </HBox.margin>
            </Label>
            <DatePicker fx:id="dpToDate" prefWidth="130" prefHeight="30" style="-fx-background-radius: 5;"/>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <Button fx:id="btnDeleteFiltered" text="Delete Filtered" onAction="#deleteFilteredSales" prefWidth="120" prefHeight="32"
                    style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-size: 11; -fx-font-weight: bold; -fx-cursor: hand;"/>
            
            <Button fx:id="btnExportToday" text="Export Today" onAction="#exportTodayData" prefWidth="110" prefHeight="32"
                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-size: 11; -fx-font-weight: bold; -fx-cursor: hand;"/>
            
            <Button fx:id="btnExport" text="Export to Excel" onAction="#exportToExcel" prefWidth="130" prefHeight="32"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-size: 11; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </HBox>
        
        <TableView fx:id="tblSales" prefHeight="350" maxHeight="350" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 4; -fx-table-cell-border-color: #e2e8f0;">
            <columns>
                <TableColumn fx:id="colSlNo" text="Sl No" prefWidth="45" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colSaleId" text="Bill No" prefWidth="65" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colAmount" text="Total" prefWidth="80" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colPaymentMode" text="Payment" prefWidth="75" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colCashAmount" text="Cash" prefWidth="75" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colGpayAmount" text="GPay" prefWidth="75" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colBilled" text="Billed" prefWidth="55" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colDateTime" text="Date &amp; Time" prefWidth="130" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="actionCol" text="Action" prefWidth="110" minWidth="90" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="deleteCol" text="Delete" prefWidth="70" style="-fx-alignment: CENTER;"/>
            </columns>
        </TableView>
        
    </VBox>

</VBox>
