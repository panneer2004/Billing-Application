<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chickencenter.ui.controllers.DashboardController"
            style="-fx-background-color: #eef2f7;">

    <left>
        <VBox prefWidth="240" style="-fx-background-color: #1e3a5f;">
            <VBox alignment="CENTER" prefHeight="110" style="-fx-background-color: #0f2744;">
                <Text text="JK" fill="#ffffff">
                    <font>
                        <Font size="32" name="Segoe UI Bold"/>
                    </font>
                </Text>
                <Text text="CHICKEN CENTER" fill="#38bdf8">
                    <font>
                        <Font size="14" name="Segoe UI"/>
                    </font>
                </Text>
            </VBox>
            
            <VBox spacing="4" style="-fx-padding: 20 0 0 0;">
                <Button onAction="#openBilling" prefHeight="48" 
                        style="-fx-background-color: #10b981; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 0 15;">
                    <graphic>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Region prefWidth="6" prefHeight="24" style="-fx-background-color: white; -fx-background-radius: 3;"/>
                            <Text text="Billing" fill="white">
                                <font>
                                    <Font size="14" name="Segoe UI"/>
                                </font>
                            </Text>
                        </HBox>
                    </graphic>
                </Button>
                
                <Region prefHeight="4"/>
                
                <Button onAction="#openInventory" prefHeight="48" 
                        style="-fx-background-color: transparent; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 0 15;">
                    <graphic>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Region prefWidth="6" prefHeight="24" style="-fx-background-color: #6366f1; -fx-background-radius: 3;"/>
                            <Text text="Inventory" fill="#cbd5e1">
                                <font>
                                    <Font size="14" name="Segoe UI"/>
                                </font>
                            </Text>
                        </HBox>
                    </graphic>
                </Button>
                
                <Region prefHeight="4"/>
                
                <Button onAction="#openPurchase" prefHeight="48" 
                        style="-fx-background-color: transparent; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 0 15;">
                    <graphic>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Region prefWidth="6" prefHeight="24" style="-fx-background-color: #f59e0b; -fx-background-radius: 3;"/>
                            <Text text="Purchase" fill="#cbd5e1">
                                <font>
                                    <Font size="14" name="Segoe UI"/>
                                </font>
                            </Text>
                        </HBox>
                    </graphic>
                </Button>
                
                <Region prefHeight="4"/>
                
                <Button onAction="#openVendors" prefHeight="48" 
                        style="-fx-background-color: transparent; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 0 15;">
                    <graphic>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Region prefWidth="6" prefHeight="24" style="-fx-background-color: #ec4899; -fx-background-radius: 3;"/>
                            <Text text="Vendors" fill="#cbd5e1">
                                <font>
                                    <Font size="14" name="Segoe UI"/>
                                </font>
                            </Text>
                        </HBox>
                    </graphic>
                </Button>
                
                <Region prefHeight="4"/>
                
                <Button onAction="#openEmployees" prefHeight="48" 
                        style="-fx-background-color: transparent; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 0 15;">
                    <graphic>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Region prefWidth="6" prefHeight="24" style="-fx-background-color: #14b8a6; -fx-background-radius: 3;"/>
                            <Text text="Employees" fill="#cbd5e1">
                                <font>
                                    <Font size="14" name="Segoe UI"/>
                                </font>
                            </Text>
                        </HBox>
                    </graphic>
                </Button>
                
                <Region prefHeight="4"/>
                
                <Button onAction="#openExpenses" prefHeight="48" 
                        style="-fx-background-color: transparent; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 0 15;">
                    <graphic>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Region prefWidth="6" prefHeight="24" style="-fx-background-color: #ef4444; -fx-background-radius: 3;"/>
                            <Text text="Expenses" fill="#cbd5e1">
                                <font>
                                    <Font size="14" name="Segoe UI"/>
                                </font>
                            </Text>
                        </HBox>
                    </graphic>
                </Button>
                
                <Region prefHeight="4"/>
                
                <Button onAction="#openReports" prefHeight="48" 
                        style="-fx-background-color: transparent; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 0 15;">
                    <graphic>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Region prefWidth="6" prefHeight="24" style="-fx-background-color: #8b5cf6; -fx-background-radius: 3;"/>
                            <Text text="Reports" fill="#cbd5e1">
                                <font>
                                    <Font size="14" name="Segoe UI"/>
                                </font>
                            </Text>
                        </HBox>
                    </graphic>
                </Button>
            </VBox>
            
            <Region VBox.vgrow="ALWAYS"/>
            
            <VBox style="-fx-padding: 0 15 20 15;">
                <Separator style="-fx-background-color: #334155;"/>
                <Label text="System Version 1.0" textFill="#64748b" style="-fx-padding: 15 0 0 0;">
                    <font>
                        <Font size="11" name="Segoe UI"/>
                    </font>
                </Label>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox style="-fx-background-color: #eef2f7; -fx-padding: 25;">
            <VBox style="-fx-background-color: white; -fx-padding: 20 30; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, #00000005, 6, 0, 0, 2);">
                <HBox>
                    <VBox>
                        <Label text="Dashboard" textFill="#1e3a5f">
                            <font>
                                <Font size="26" name="Segoe UI Bold"/>
                            </font>
                        </Label>
                        <Label fx:id="lblDate" textFill="#64748b">
                            <font>
                                <Font size="13" name="Segoe UI"/>
                            </font>
                        </Label>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox alignment="CENTER_RIGHT">
                        <HBox spacing="8" alignment="CENTER">
                            <Region prefWidth="10" prefHeight="10" style="-fx-background-color: #10b981; -fx-background-radius: 5;"/>
                            <Label text="System Online" textFill="#10b981">
                                <font>
                                    <Font size="12" name="Segoe UI"/>
                                </font>
                            </Label>
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>

            <HBox spacing="20" style="-fx-padding: 25 0 0 0;">
                <VBox prefWidth="200" style="-fx-background-color: white; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, #00000005, 8, 0, 0, 3);">
                    <VBox style="-fx-background-color: #10b981; -fx-padding: 18; -fx-background-radius: 14 14 0 0;">
                        <Label text="Today's Sales" textFill="white">
                            <font>
                                <Font size="13" name="Segoe UI"/>
                            </font>
                        </Label>
                    </VBox>
                    <VBox style="-fx-padding: 18;">
                        <Label fx:id="lblTodaySales" text="Rs.0.00" textFill="#1e3a5f">
                            <font>
                                <Font size="24" name="Segoe UI Bold"/>
                            </font>
                        </Label>
                    </VBox>
                </VBox>

                <VBox prefWidth="200" style="-fx-background-color: white; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, #00000005, 8, 0, 0, 3);">
                    <VBox style="-fx-background-color: #0ea5e9; -fx-padding: 18; -fx-background-radius: 14 14 0 0;">
                        <Label text="Sales Count" textFill="white">
                            <font>
                                <Font size="13" name="Segoe UI"/>
                            </font>
                        </Label>
                    </VBox>
                    <VBox style="-fx-padding: 18;">
                        <Label fx:id="lblTodayCount" text="0" textFill="#1e3a5f">
                            <font>
                                <Font size="24" name="Segoe UI Bold"/>
                            </font>
                        </Label>
                    </VBox>
                </VBox>

                <VBox prefWidth="200" style="-fx-background-color: white; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, #00000005, 8, 0, 0, 3);">
                    <VBox style="-fx-background-color: #6366f1; -fx-padding: 18; -fx-background-radius: 14 14 0 0;">
                        <Label text="Net Profit/Loss" textFill="white">
                            <font>
                                <Font size="13" name="Segoe UI"/>
                            </font>
                        </Label>
                    </VBox>
                    <VBox style="-fx-padding: 18;">
                        <Label fx:id="lblProfitLoss" text="Rs.0.00" textFill="#1e3a5f">
                            <font>
                                <Font size="24" name="Segoe UI Bold"/>
                            </font>
                        </Label>
                    </VBox>
                </VBox>
            </HBox>

            <VBox style="-fx-padding: 25 0 0 0;">
                <VBox style="-fx-background-color: white; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, #00000005, 8, 0, 0, 3);">
                    <VBox style="-fx-padding: 20 25;">
                        <Label text="Quick Actions" textFill="#1e3a5f">
                            <font>
                                <Font size="18" name="Segoe UI Bold"/>
                            </font>
                        </Label>
                    </VBox>
                    <Separator/>
                    <HBox spacing="18" style="-fx-padding: 25;">
                        <Button onAction="#openBilling" prefHeight="70" prefWidth="160" 
                                style="-fx-background-color: #10b981; -fx-background-radius: 12; -fx-cursor: hand;">
                            <graphic>
                                <VBox alignment="CENTER" spacing="4">
                                    <Text text="New Sale" fill="white">
                                        <font>
                                            <Font size="15" name="Segoe UI Bold"/>
                                        </font>
                                    </Text>
                                    <Text text="Start billing" fill="white" opacity="0.85">
                                        <font>
                                            <Font size="11" name="Segoe UI"/>
                                        </font>
                                    </Text>
                                </VBox>
                            </graphic>
                        </Button>
                        
                        <Button onAction="#openPurchase" prefHeight="70" prefWidth="160" 
                                style="-fx-background-color: #f59e0b; -fx-background-radius: 12; -fx-cursor: hand;">
                            <graphic>
                                <VBox alignment="CENTER" spacing="4">
                                    <Text text="Purchase" fill="white">
                                        <font>
                                            <Font size="15" name="Segoe UI Bold"/>
                                        </font>
                                    </Text>
                                    <Text text="Add stock" fill="white" opacity="0.85">
                                        <font>
                                            <Font size="11" name="Segoe UI"/>
                                        </font>
                                    </Text>
                                </VBox>
                            </graphic>
                        </Button>
                        
                        <Button onAction="#openExpenses" prefHeight="70" prefWidth="160" 
                                style="-fx-background-color: #ef4444; -fx-background-radius: 12; -fx-cursor: hand;">
                            <graphic>
                                <VBox alignment="CENTER" spacing="4">
                                    <Text text="Expenses" fill="white">
                                        <font>
                                            <Font size="15" name="Segoe UI Bold"/>
                                        </font>
                                    </Text>
                                    <Text text="Manage expenses" fill="white" opacity="0.85">
                                        <font>
                                            <Font size="11" name="Segoe UI"/>
                                        </font>
                                    </Text>
                                </VBox>
                            </graphic>
                        </Button>
                        
                        <Button onAction="#openReports" prefHeight="70" prefWidth="160" 
                                style="-fx-background-color: #6366f1; -fx-background-radius: 12; -fx-cursor: hand;">
                            <graphic>
                                <VBox alignment="CENTER" spacing="4">
                                    <Text text="Reports" fill="white">
                                        <font>
                                            <Font size="15" name="Segoe UI Bold"/>
                                        </font>
                                    </Text>
                                    <Text text="View analytics" fill="white" opacity="0.85">
                                        <font>
                                            <Font size="11" name="Segoe UI"/>
                                        </font>
                                    </Text>
                                </VBox>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </center>

</BorderPane>
